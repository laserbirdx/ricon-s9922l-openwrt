/dts-v1/;

#include "mt7620a.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "alotcer,s9922l", "ralink,mt7620a-soc";
	model = "Alotcer S9922L";

	chosen {
		bootargs = "console=ttyS0,115200";
	};
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
		m25p,fast-read;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			factory: partition@30000 {
				label = "factory";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "config";
				reg = <0x40000 0x10000>;
				read-only;
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0xfb0000>;
			};
		};
	};
};

&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};

&ethernet {
	nvmem-cells = <&macaddr_factory_1028>;
	nvmem-cell-names = "mac-address";
	mediatek,portmap = "lllll";
};

&wmac {
	ralink,mtd-eeprom = <&factory 0x0>;
};

&factory {
	compatible = "nvmem-cells";
	#address-cells = <1>;
	#size-cells = <1>;

	macaddr_factory_1028: macaddr@1028 {
		reg = <0x1028 0x6>;
	};
};

&state_default {
	gpio {
		groups = "uartf", "wled", "spi refclk", "ephy", "mdio";
		function = "gpio";
	};
};

&pcie {
	status = "okay";
};
